{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{headline}}",
  "description": "{{description}}",
  "author": {
    "@type": "Person",
    "name": "{{author_name}}"
  },
  "publisher": {
    "@type": "Organization",
    "name": "{{publisher_name}}",
    "logo": {
      "@type": "ImageObject",
      "url": "{{logo_url}}"
    }
  },
  "datePublished": "{{date_published}}",
  "dateModified": "{{date_modified}}",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{page_url}}"
  },
  "image": {
    "@type": "ImageObject",
    "url": "{{featured_image_url}}",
    "width": 1200,
    "height": 630
  },
  "citation": []
}
